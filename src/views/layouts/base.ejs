<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Events Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script>document.addEventListener("htmx:beforeSwap", function(e) { if (e.detail.xhr.status >= 400) { e.detail.shouldSwap = true; e.detail.isError = false; } });</script>
  </head>
  <body class="min-h-screen bg-gradient-to-b from-slate-50 to-slate-100 text-slate-900 p-6">
    <div class="max-w-5xl mx-auto">
      <nav class="flex items-center justify-between gap-3 mb-6 flex-wrap">
        <a
          href="<%= session?.authenticatedUser ? '/home' : '/login' %>"
          class="inline-flex items-center gap-2.5 px-4 py-3 rounded-xl bg-white border border-slate-200 shadow-lg font-bold text-slate-900 no-underline"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-b from-blue-400 to-blue-600"></span>
          Events Dashboard
        </a>
        <div class="flex items-center gap-3 flex-wrap">
          <% if (session?.authenticatedUser) { %>
            <% if (session.authenticatedUser.role === "admin" || session.authenticatedUser.role === "staff") { %>
              <a href="/organizer/dashboard" class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-full transition-colors no-underline text-sm shadow-sm">My Events</a>
            <% } %>
            <% if (session.authenticatedUser.role === "admin") { %>
              <a href="/admin/users" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-full transition-colors no-underline text-sm shadow-sm">Manage Users</a>
            <% } %>
            <% if (session.authenticatedUser.role === "user") { %>
              <a href="/rsvps/me" class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-full transition-colors no-underline text-sm shadow-sm">My RSVPs</a>
            <% } %>
            <span class="text-slate-500 ml-2">
              Signed in as <strong class="text-slate-700"><%= session.authenticatedUser.displayName %></strong>
              (<%= session.authenticatedUser.role %>)
            </span>
            <form method="post" action="/logout" class="m-0 ml-1">
              <button
                type="submit"
                class="px-4 py-2 rounded-full bg-white text-slate-600 border border-slate-200 cursor-pointer hover:bg-slate-50 hover:text-rose-600 font-bold text-sm shadow-sm transition-colors"
              >
                Log out
              </button>
            </form>
          <% } else { %>
            <a href="/login" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-full transition-colors no-underline text-sm shadow-md">Log in</a>
          <% } %>
        </div>
      </nav>
      <main class="max-w-5xl mx-auto"><%- body %></main>
    </div>
  </body>
</html>
