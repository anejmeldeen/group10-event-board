<% if (!events || events.length === 0) { %>
  <div class="bg-white rounded-3xl border border-slate-100 p-16 text-center shadow-2xl shadow-slate-200/30">
    <div class="w-24 h-24 bg-indigo-50 text-indigo-300 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
      </svg>
    </div>
    <h3 class="text-2xl font-black text-slate-900 tracking-tight">No saved events yet</h3>
    <p class="text-slate-500 mt-2 text-lg">Browse events and use the bookmark button to build your personal collection.</p>
    <a href="/home" class="mt-8 inline-flex items-center gap-2 px-8 py-3 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200 no-underline">
      Browse Events
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
<% } else { %>
  <div class="mb-6 flex items-center justify-between gap-4 flex-wrap">
    <div>
      <p class="text-sm font-black uppercase tracking-widest text-slate-400">Personal Collection</p>
      <h2 class="text-2xl font-black text-slate-900 tracking-tight">
        <%= events.length %> saved <%= events.length === 1 ? "event" : "events" %>
      </h2>
    </div>
    <a href="/home" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white hover:bg-indigo-50 text-indigo-700 font-black rounded-xl border border-indigo-100 hover:border-indigo-300 shadow-sm transition-all no-underline">
      Add more events
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
      </svg>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% events.forEach(event => { %>
      <article class="group bg-white rounded-3xl border border-slate-100 shadow-xl shadow-slate-200/50 transition-all hover:shadow-indigo-500/10 hover:-translate-y-1 flex flex-col h-full overflow-hidden">
        <div class="h-2 bg-gradient-to-r from-indigo-500 via-blue-500 to-emerald-400"></div>

        <div class="p-6 flex flex-col h-full">
          <div class="flex items-start justify-between gap-4 mb-4">
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"></path>
                </svg>
                Saved
              </span>
              <span class="inline-flex px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-full bg-indigo-50 text-indigo-600 border border-indigo-100">
                <%= event.category %>
              </span>
            </div>

            <form
              method="POST"
              action="/saved/<%= event.id %>/toggle"
              hx-post="/saved/<%= event.id %>/toggle"
              hx-target="#saved-list-content"
              hx-swap="innerHTML"
            >
              <input type="hidden" name="returnTo" value="/saved" />
              <input type="hidden" name="context" value="saved" />
              <button
                type="submit"
                class="shrink-0 p-2 text-emerald-600 hover:text-rose-500 transition-colors bg-emerald-50 hover:bg-rose-50 rounded-xl border border-emerald-100 hover:border-rose-100 cursor-pointer"
                title="Remove from saved"
                aria-label="Remove from saved"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"></path>
                </svg>
                <span class="sr-only">Remove from saved</span>
              </button>
            </form>
          </div>

          <a href="/events/<%= event.id %>" class="flex-grow no-underline">
            <h3 class="text-xl font-black text-slate-900 leading-tight group-hover:text-indigo-600 transition-colors mb-4">
              <%= event.title %>
            </h3>

            <p class="text-sm text-slate-500 leading-relaxed line-clamp-3 mb-5">
              <%= event.description %>
            </p>

            <div class="space-y-3">
              <div class="flex items-center gap-3 text-sm font-bold text-slate-600">
                <div class="w-9 h-9 rounded-xl bg-slate-50 flex items-center justify-center text-indigo-500 shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <span><%= event.location %></span>
              </div>

              <div class="flex items-center gap-3 text-sm font-bold text-slate-600">
                <div class="w-9 h-9 rounded-xl bg-slate-50 flex items-center justify-center text-indigo-500 shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 002 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <time><%= new Date(event.startDate).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) %></time>
              </div>
            </div>
          </a>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
              By <%= event.organizerName %>
            </div>
            <a href="/events/<%= event.id %>" class="text-xs font-black text-indigo-600 hover:text-indigo-700 uppercase tracking-wider no-underline flex items-center gap-1.5 group/link">
              View Details
              <svg class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>
