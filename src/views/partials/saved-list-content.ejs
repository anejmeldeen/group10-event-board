<% if (!events || events.length === 0) { %>
  <div class="bg-white rounded-3xl border border-slate-100 p-16 text-center shadow-2xl shadow-slate-200/30">
    <div class="w-24 h-24 bg-indigo-50 text-indigo-300 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" /></svg>
    </div>
    <h3 class="text-2xl font-black text-slate-900 tracking-tight">No saved events</h3>
    <p class="text-slate-500 mt-2 text-lg">Browse events and save them here to keep track of what interests you.</p>
    <a href="/home" class="mt-8 inline-block px-8 py-3 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200 no-underline">Browse Events</a>
  </div>
<% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% events.forEach(event => { %>
      <article class="group bg-white rounded-3xl border border-slate-100 p-6 shadow-xl shadow-slate-200/50 transition-all hover:shadow-indigo-500/10 hover:-translate-y-1 flex flex-col h-full">
        <!-- Card Header -->
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-full bg-rose-50 text-rose-600 border border-rose-100">
              Saved
            </span>
            <span class="inline-flex px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-full bg-indigo-50 text-indigo-600 border border-indigo-100">
              <%= event.category %>
            </span>
          </div>
          
          <form
            method="POST"
            action="/saved/<%= event.id %>/toggle"
            hx-post="/saved/<%= event.id %>/toggle"
            hx-target="#saved-list-content"
            hx-swap="innerHTML"
          >
            <input type="hidden" name="returnTo" value="/saved" />
            <input type="hidden" name="context" value="saved" />
            <button type="submit" class="shrink-0 p-2 text-slate-300 hover:text-rose-500 transition-colors bg-slate-50 hover:bg-rose-50 rounded-xl border border-slate-100 hover:border-rose-100 cursor-pointer" title="Remove from saved">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </button>
          </form>
        </div>

        <!-- Card Body -->
        <a href="/events/<%= event.id %>" class="flex-grow no-underline">
          <h3 class="text-lg font-black text-slate-900 leading-tight group-hover:text-indigo-600 transition-colors mb-3">
            <%= event.title %>
          </h3>
          
          <div class="space-y-2.5">
            <div class="flex items-center gap-2 text-sm font-bold text-slate-500">
              <div class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center text-indigo-500 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <%= event.location %>
            </div>
            
            <div class="flex items-center gap-2 text-sm font-bold text-slate-500">
              <div class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center text-indigo-500 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              </div>
              <time><%= new Date(event.startDate).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) %></time>
            </div>
          </div>
        </a>

        <!-- Card Footer -->
        <div class="mt-6 pt-4 border-t border-slate-50 flex items-center justify-between">
          <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
            By <%= event.organizerName %>
          </div>
          <a href="/events/<%= event.id %>" class="text-xs font-black text-indigo-600 hover:text-indigo-700 uppercase tracking-wider no-underline flex items-center gap-1.5 group/link">
            View Details
            <svg class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>