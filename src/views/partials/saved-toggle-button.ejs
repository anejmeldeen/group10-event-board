<form
  method="POST"
  action="/saved/<%= eventId %>/toggle"
  <% if (typeof htmx !== 'undefined' && htmx) { %>
    hx-post="/saved/<%= eventId %>/toggle"
    hx-target="this"
    hx-swap="outerHTML"
  <% } %>
>
  <input type="hidden" name="returnTo" value="<%= returnTo %>" />
  <input type="hidden" name="context" value="<%= context %>" />

  <% if (saved) { %>
    <button
      type="submit"
      class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-xl shadow-lg shadow-emerald-500/20 cursor-pointer flex items-center justify-center gap-2 transition-all border border-emerald-500"
      aria-label="Remove saved event"
      title="Saved. Click to remove."
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"></path>
      </svg>
      Saved
    </button>
  <% } else { %>
    <button
      type="submit"
      class="w-full py-2.5 px-4 bg-white hover:bg-indigo-50 text-indigo-700 hover:text-indigo-800 font-black rounded-xl shadow-sm border-2 border-indigo-100 hover:border-indigo-300 transition-all cursor-pointer flex items-center justify-center gap-2"
      aria-label="Save event for later"
      title="Save for later"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 4.5A2.5 2.5 0 017.5 2h5A2.5 2.5 0 0115 4.5V18l-5-2.75L5 18V4.5z" />
      </svg>
      Save for Later
    </button>
  <% } %>
</form>
