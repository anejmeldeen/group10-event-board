<!-- Hero Header Section -->
<div class="relative bg-gradient-to-br from-indigo-900 via-indigo-800 to-blue-900 rounded-3xl overflow-hidden mb-10 shadow-2xl shadow-slate-200/50">
  <div class="absolute top-0 right-0 -mt-20 -mr-20 w-80 h-80 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
  <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-72 h-72 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse" style="animation-delay: 2s;"></div>
  
  <div class="relative z-10 px-8 py-10 sm:px-12 sm:py-12 text-white flex flex-col md:flex-row items-center justify-between gap-8">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-indigo-100 bg-white/10 rounded-full uppercase shadow-lg shadow-black/10 backdrop-blur-md border border-white/20 mb-3">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" /></svg>
        Your Collection
      </div>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-indigo-100">
        Saved Events
      </h1>
      <p class="text-indigo-200 mt-2 text-lg font-medium">Events you've bookmarked to keep track of.</p>
    </div>
    <div class="shrink-0">
      <a href="/home" class="px-6 py-3 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white font-bold rounded-xl transition-all shadow-lg no-underline flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Back to Explore
      </a>
    </div>
  </div>
</div>

<% if (pageError) { %>
  <div class="mb-8">
    <%- include("partials/error", { message: pageError }) %>
  </div>
<% } %>

<div id="saved-list-content">
  <%- include("partials/saved-list-content", { events, user }) %>
</div>