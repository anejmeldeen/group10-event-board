<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<div class="bg-white rounded-3xl shadow-2xl shadow-slate-200/50 border border-slate-100 overflow-hidden relative mb-10">
  <div class="relative bg-gradient-to-br from-indigo-900 via-indigo-800 to-blue-900 px-8 py-10 sm:px-12 sm:py-12 text-white overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-80 h-80 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-72 h-72 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse" style="animation-delay: 2s;"></div>
    
    <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-indigo-100 bg-white/10 rounded-full uppercase shadow-lg shadow-black/10 backdrop-blur-md border border-white/20 mb-3">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          Organizer Tool
        </span>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-indigo-100">
          Organizer Dashboard
        </h1>
        <p class="text-indigo-200 text-sm sm:text-base font-medium max-w-xl mt-2">
          Manage your events across all stages, from draft to published to past.
        </p>
      </div>
      <a
        href="/events/create"
        class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white font-bold rounded-xl shadow-lg transition-colors no-underline whitespace-nowrap"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Create Event
      </a>
    </div>
  </div>
</div>

<% if (!published.length && !draft.length && !cancelledOrPast.length) { %>
  <div class="bg-white rounded-3xl border border-slate-100 p-16 text-center shadow-2xl shadow-slate-200/30">
    <div class="w-24 h-24 bg-indigo-50 text-indigo-300 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
    </div>
    <h3 class="text-2xl font-black text-slate-900 tracking-tight">No events found</h3>
    <p class="text-slate-500 mt-2 text-lg">You haven't created any events yet.</p>
    <button type="button" onclick="window.location.href='/events/create'" class="mt-8 px-8 py-3 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200 cursor-pointer border-none">Create Event</button>
  </div>
<% } else { %>
  <div class="space-y-12">

    <!-- Published Section -->
    <% if (published.length > 0) { %>
  <section>
    <h2 class="text-xl font-black text-slate-900 mb-6 flex items-center gap-3 border-b border-slate-100 pb-3">
      <span class="w-4 h-4 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50"></span>
      Published / Live
      <span class="text-xs font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md ml-1"><%= published.length %></span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% published.forEach(event => { %>
        <%- include("partials/organizer-dashboard-row", { item: event }) %>
      <% }) %>
    </div>
  </section>
<% } %>

    <!-- Draft Section -->
    <% if (draft.length > 0) { %>
  <section>
    <h2 class="text-xl font-black text-slate-900 mb-6 flex items-center gap-3 border-b border-slate-100 pb-3">
      <span class="w-4 h-4 rounded-full bg-amber-400 shadow-sm shadow-amber-400/50"></span>
      Drafts
      <span class="text-xs font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md ml-1"><%= draft.length %></span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% draft.forEach(event => { %>
        <%- include("partials/organizer-dashboard-row", { item: event }) %>
      <% }) %>
    </div>
  </section>
<% } %>

    <!-- Past/Cancelled Section -->
    <% if (cancelledOrPast.length > 0) { %>
      <section x-data="{ open: false }">
        <button
          x-on:click="open = !open"
          class="w-full text-left cursor-pointer bg-transparent border-none p-0"
        >
          <h2 class="text-xl font-black text-slate-900 mb-6 flex items-center gap-3 border-b border-slate-100 pb-3">
            <span class="w-4 h-4 rounded-full bg-slate-400 shadow-sm shadow-slate-400/50"></span>
            Past & Cancelled
            <span class="text-xs font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md ml-1"><%= cancelledOrPast.length %></span>
            <svg
              class="w-4 h-4 ml-auto text-slate-400 transition-transform"
              x-bind:class="open ? 'rotate-180' : ''"
              fill="none" viewBox="0 0 24 24" stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </h2>
        </button>
        <div
          x-show="open"
          x-transition
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
          <% cancelledOrPast.forEach(event => { %>
            <%- include("partials/organizer-dashboard-row", { item: event }) %>
          <% }) %>
        </div>
      </section>
    <% } %>

  </div>
<% } %>
