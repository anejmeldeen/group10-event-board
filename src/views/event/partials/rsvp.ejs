<% if (typeof variant !== 'undefined' && variant === 'compact') { %>
  <% if (rsvpView.canRsvp) { %>
    <form hx-post="/events/<%= eventId %>/rsvp" hx-target="this" hx-swap="outerHTML" class="relative z-30">
      <input type="hidden" name="variant" value="compact">
      <% 
        const isFull = rsvpView.capacity > 0 && rsvpView.goingCount >= rsvpView.capacity;
        let buttonText = 'RSVP';
        let buttonClass = 'bg-white border-2 border-indigo-100 text-indigo-600 hover:border-indigo-600 hover:bg-indigo-50';
        
        if (rsvpView.currentStatus === 'going') {
          buttonText = "Cancel RSVP";
          buttonClass = 'bg-rose-500 text-white hover:bg-rose-600 border-none';
        } else if (rsvpView.currentStatus === 'waitlisted') {
          buttonText = 'Leave Waitlist';
          buttonClass = 'bg-amber-500 text-white hover:bg-amber-600 border-none';
        } else if (isFull && (rsvpView.currentStatus === 'none' || rsvpView.currentStatus === 'cancelled')) {
          buttonText = 'Join Waitlist';
        }
      %>
      <button type="submit" class="w-full py-2.5 px-4 <%= buttonClass %> font-bold rounded-xl transition-all shadow-sm cursor-pointer">
        <%= buttonText %>
      </button>
    </form>
  <% } %>
<% } else { %>
<div class="space-y-4">
  <div>
    <span class="block text-xs text-slate-500 font-medium mb-1">Attendance</span>
    <div class="flex items-center gap-2">
      <span class="text-slate-900 font-medium text-lg"><%= rsvpView.goingCount %></span>
      <% if (capacity > 0) { %>
        <span class="text-slate-400">/ <%= capacity %> attending</span>
      <% } else { %>
        <span class="text-slate-400">attending (Unlimited)</span>
      <% } %>
    </div>
    <% if (capacity > 0) { %>
      <div class="w-full bg-slate-200 rounded-full h-1.5 mt-2">
        <div class="bg-blue-600 h-1.5 rounded-full" style="width: <%= Math.min(100, (rsvpView.goingCount / capacity) * 100) %>%"></div>
      </div>
    <% } %>
  </div>

  <% if (rsvpView.canRsvp) { %>
    <form hx-post="/events/<%= eventId %>/rsvp" hx-target="#rsvp-section" hx-swap="innerHTML" x-data="{ loading: false }" x-on:submit="loading = true">
      <% 
        const isFull = rsvpView.capacity > 0 && rsvpView.goingCount >= rsvpView.capacity;
        const status = rsvpView.currentStatus;
      %>
      <% if (status === 'none' || status === 'cancelled') { %>
        <button type="submit" class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-md transition-colors text-lg cursor-pointer">
          <%= isFull ? 'Join Waitlist' : 'RSVP' %>
        </button>
      <% } else if (status === 'going') { %>
        <button type="submit" class="w-full py-3 px-4 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-lg shadow-md transition-colors text-lg cursor-pointer">Cancel RSVP</button>
      <% } else if (status === 'waitlisted') { %>
        <button type="submit" class="w-full py-3 px-4 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg shadow-md transition-colors text-lg cursor-pointer">Leave Waitlist</button>
      <% } %>
    </form>
  <% } else { %>
    <button disabled class="w-full py-3 px-4 bg-slate-300 text-slate-500 font-bold rounded-lg cursor-not-allowed text-lg">Unavailable</button>
  <% } %>
</div>
<% } %>