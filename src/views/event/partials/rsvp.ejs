<% 
  const isCompact = typeof variant !== 'undefined' && variant === 'compact';
  const sectionId = `rsvp-section-${eventId}`;
%>

<div id="<%= sectionId %>" class="relative <%= isCompact ? '' : 'w-full' %>">
  <form 
    hx-post="/events/<%= eventId %>/rsvp" 
    hx-target="#<%= sectionId %>" 
    hx-swap="outerHTML transition:true"
    x-data="{ loading: false, hover: false }"
    @submit="loading = true"
    class="w-full"
  >
    <input type="hidden" name="variant" value="<%= isCompact ? 'compact' : 'large' %>">

    <% if (!rsvpView.canRsvp) { %>
      <div 
        x-show="true"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
      >
        <button 
          disabled
          class="w-full <%= isCompact ? 'py-2.5 px-4 text-sm' : 'py-4 px-6 text-lg' %> bg-slate-50 text-slate-400 font-bold rounded-2xl border-2 border-slate-100 cursor-not-allowed transition-all duration-300"
        >
          <span class="flex items-center justify-center gap-2">
            <% if (!isCompact) { %>
              <svg class="w-5 h-5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
              </svg>
            <% } %>
            RSVP Unavailable
          </span>
        </button>
      </div>

    <% } else if (rsvpView.currentStatus === 'going') { %>
      <div 
        x-show="true"
        x-transition:enter="transition ease-out duration-500"
        x-transition:enter-start="opacity-0 translate-y-4"
        x-transition:enter-end="opacity-100 translate-y-0"
      >
        <button 
          type="submit"
          :disabled="loading"
          @mouseenter="hover = true"
          @mouseleave="hover = false"
          class="group relative w-full <%= isCompact ? 'py-2.5 px-4 text-sm' : 'py-4 px-6 text-lg' %> font-black rounded-2xl transition-all duration-300 cursor-pointer overflow-hidden shadow-sm hover:shadow-xl hover:shadow-rose-500/10 active:scale-[0.98] <%= isCompact ? 'bg-rose-500 text-white hover:bg-rose-600' : 'bg-white text-emerald-600 border-2 border-emerald-100 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600' %> disabled:opacity-50"
        >
          <div class="relative z-10 flex items-center justify-center gap-2 transition-transform duration-300 group-hover:scale-105">
            <div x-show="!hover" x-transition.opacity.duration.200ms class="flex items-center gap-2">
              <% if (!isCompact) { %>
                <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              <% } %>
              <span><%= isCompact ? 'Going' : "You're Going" %></span>
            </div>
            <div x-show="hover" x-transition.opacity.duration.200ms class="flex items-center gap-2">
              <svg class="w-5 h-5 <%= isCompact ? 'text-white' : 'text-rose-500' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>Cancel RSVP</span>
            </div>
          </div>
          <!-- Shine effect -->
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite] pointer-events-none"></div>
          
          <div x-show="loading" class="absolute inset-0 bg-black/5 backdrop-blur-[2px] flex items-center justify-center z-20">
            <svg class="animate-spin h-5 w-5 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </button>
      </div>

    <% } else if (rsvpView.currentStatus === 'waitlisted') { %>
      <div 
        x-show="true"
        x-transition:enter="transition ease-out duration-500"
        x-transition:enter-start="opacity-0 translate-y-4"
        x-transition:enter-end="opacity-100 translate-y-0"
      >
        <button 
          type="submit"
          :disabled="loading"
          @mouseenter="hover = true"
          @mouseleave="hover = false"
          class="group relative w-full <%= isCompact ? 'py-2.5 px-4 text-sm' : 'py-4 px-6 text-lg' %> font-black rounded-2xl transition-all duration-300 cursor-pointer overflow-hidden shadow-sm hover:shadow-xl hover:shadow-rose-500/10 active:scale-[0.98] <%= isCompact ? 'bg-amber-500 text-white hover:bg-amber-600' : 'bg-white text-amber-600 border-2 border-amber-100 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600' %> disabled:opacity-50"
        >
          <div class="relative z-10 flex items-center justify-center gap-2 transition-transform duration-300 group-hover:scale-105">
            <div x-show="!hover" x-transition.opacity.duration.200ms class="flex items-center gap-2">
              <% if (!isCompact) { %>
                <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              <% } %>
              <span>On Waitlist</span>
            </div>
            <div x-show="hover" x-transition.opacity.duration.200ms class="flex items-center gap-2">
              <svg class="w-5 h-5 <%= isCompact ? 'text-white' : 'text-rose-500' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>Leave Waitlist</span>
            </div>
          </div>
          <div x-show="loading" class="absolute inset-0 bg-black/5 backdrop-blur-[2px] flex items-center justify-center z-20">
            <svg class="animate-spin h-5 w-5 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </button>
      </div>

    <% } else { %>
      <% 
        const isFull = rsvpView.capacity > 0 && rsvpView.goingCount >= rsvpView.capacity;
        const buttonText = isFull ? 'Join Waitlist' : 'RSVP to Event';
        const compactText = isFull ? 'Join Waitlist' : 'RSVP';
      %>
      <div 
        x-show="true"
        x-transition:enter="transition ease-out duration-500"
        x-transition:enter-start="opacity-0 translate-y-4"
        x-transition:enter-end="opacity-100 translate-y-0"
      >
        <button 
          type="submit"
          :disabled="loading"
          class="group relative w-full <%= isCompact ? 'py-2.5 px-4 text-sm' : 'py-4 px-6 text-lg' %> font-black rounded-2xl transition-all duration-500 cursor-pointer overflow-hidden shadow-lg shadow-indigo-200 hover:shadow-indigo-400/30 hover:-translate-y-0.5 active:scale-[0.98] <%= isCompact ? 'bg-white border-2 border-indigo-100 text-indigo-600 hover:border-indigo-600 hover:bg-indigo-50' : 'bg-indigo-600 text-white' %> disabled:opacity-50"
        >
          <div class="relative z-10 flex items-center justify-center gap-3 transition-transform duration-300 group-hover:scale-105">
            <span><%= isCompact ? compactText : buttonText %></span>
            <% if (!isCompact) { %>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            <% } %>
          </div>
          
          <!-- Animated gradient background for large button -->
          <% if (!isCompact) { %>
            <div class="absolute inset-0 bg-gradient-to-r from-indigo-600 via-blue-600 to-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <% } %>

          <div x-show="loading" class="absolute inset-0 <%= isCompact ? 'bg-white/80' : 'bg-indigo-700' %> backdrop-blur-sm flex items-center justify-center z-20">
            <svg class="animate-spin h-5 w-5 <%= isCompact ? 'text-indigo-600' : 'text-white' %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </button>
      </div>
    <% } %>
  </form>
</div>

<style>
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }
</style>