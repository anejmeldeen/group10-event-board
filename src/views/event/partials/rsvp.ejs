<div id="rsvp-section">
  <form 
    hx-post="/events/<%= eventId %>/rsvp" 
    hx-target="#rsvp-section" 
    hx-swap="innerHTML"

    x-data="{ loading: false }"
    x-on:submit="loading = true"
  >

    <% if (!rsvpView.allowed) { %>

      <div x-transition>
        <button 
          disabled
          class="w-full py-3 px-4 bg-slate-300 text-slate-500 font-bold rounded-lg cursor-not-allowed text-lg opacity-75"
        >
          RSVP Unavailable
        </button>
      </div>

    <% } else if (rsvpView.currentStatus === 'going') { %>

      <div x-transition>
        <button 
          type="submit"
          :disabled="loading"
          @click="loading = true"
          x-bind:class="loading ? 'scale-95 opacity-75' : ''"
          class="w-full py-3 px-4 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg shadow-md transition-all duration-150 text-lg cursor-pointer disabled:opacity-50"
        >
          Going ✓ (Click to Cancel)
        </button>
      </div>

    <% } else if (rsvpView.currentStatus === 'waitlisted') { %>

      <div x-transition>
        <button 
          type="submit"
          :disabled="loading"
          @click="loading = true"
          x-bind:class="loading ? 'scale-95 opacity-75' : ''"
          class="w-full py-3 px-4 bg-yellow-500 hover:bg-yellow-600 text-white font-bold rounded-lg shadow-md transition-all duration-150 text-lg cursor-pointer disabled:opacity-50"
        >
          Waitlisted (Click to Cancel)
        </button>
      </div>

    <% } else { %>

      <div x-transition>
        <button 
          type="submit"
          :disabled="loading"
          @click="loading = true"
          x-bind:class="loading ? 'scale-95 opacity-75' : ''"
          class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-md transition-all duration-150 text-lg cursor-pointer disabled:opacity-50"
        >
          RSVP
        </button>
      </div>

    <% } %>

  </form>
</div>