<div
  id="event-lifecycle-controls"
  x-data="{ show: false }"
  x-init="requestAnimationFrame(() => show = true)"
  x-bind:class="show ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 translate-y-2 scale-95'"
  class="flex flex-col gap-3 transition-all duration-300 ease-out"
>
  <% if (event.status === 'draft') { %>
    <span class="inline-flex items-center gap-2 px-3 py-1 text-xs font-bold tracking-wider text-amber-800 bg-amber-100 border border-amber-300 rounded-full uppercase w-fit shadow-sm">
      <span class="w-2 h-2 rounded-full bg-amber-500"></span>
      Draft
    </span>
  <% } else if (event.status === 'cancelled') { %>
    <span class="inline-flex items-center gap-2 px-3 py-1 text-xs font-bold tracking-wider text-rose-700 bg-rose-100 border border-rose-300 rounded-full uppercase w-fit shadow-sm">
      <span class="w-2 h-2 rounded-full bg-rose-500"></span>
      Cancelled
    </span>
  <% } else { %>
    <span class="inline-flex items-center gap-2 px-3 py-1 text-xs font-bold tracking-wider text-emerald-700 bg-emerald-100 border border-emerald-300 rounded-full uppercase w-fit shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      Published
    </span>
  <% } %>

  <% if (user.role === 'admin' || user.role === 'staff') { %>
    <% if (event.status === 'draft') { %>
      <form
        method="POST"
        action="/events/<%= event.id %>/publish"
        hx-post="/events/<%= event.id %>/publish"
        hx-target="#event-lifecycle-controls"
        hx-swap="outerHTML"
        class="w-full"
      >
        <button type="submit" class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg shadow-md transition-colors text-lg cursor-pointer">
          Publish Event
        </button>
      </form>
    <% } %>

    <% if ((user.userId === event.organizerId || user.role === 'admin') && event.status !== 'cancelled') { %>
      <a href="/events/<%= event.id %>/edit" class="block w-full py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold rounded-lg border border-slate-300 transition-colors text-center no-underline">
        Edit Event
      </a>
    <% } %>

    <% if (event.status === 'published') { %>
      <form
        method="POST"
        action="/events/<%= event.id %>/cancel"
        hx-post="/events/<%= event.id %>/cancel"
        hx-target="#event-lifecycle-controls"
        hx-swap="outerHTML"
        class="w-full"
      >
        <button type="submit" class="w-full py-2.5 px-4 bg-white hover:bg-rose-50 text-rose-600 font-semibold rounded-lg border border-rose-200 transition-colors cursor-pointer">
          Cancel Event
        </button>
      </form>
    <% } %>
  <% } %>
</div>