<article id="event-row-<%= item.id %>" class="bg-white rounded-3xl shadow-lg shadow-slate-200/50 border border-slate-100 overflow-hidden transition-all duration-300 hover:shadow-2xl hover:-translate-y-1 group relative flex flex-col h-full">
  <!-- Decorative side bar -->
  <div class="absolute left-0 top-0 bottom-0 w-2 <%= item.status === 'published' ? 'bg-emerald-500' : item.status === 'draft' ? 'bg-amber-400' : 'bg-slate-400' %> transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300 z-10"></div>

  <div class="p-6 flex flex-col flex-grow relative z-10">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="w-full">
        <div class="flex gap-2 items-center mb-3">
          <% if (item.status === 'draft') { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-amber-900 bg-amber-400 rounded-md uppercase shadow-sm">
              Draft
            </span>
          <% } else if (item.status === 'published') { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-emerald-900 bg-emerald-400 rounded-md uppercase shadow-sm">
              Published
            </span>
          <% } else if (item.status === 'cancelled') { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-rose-900 bg-rose-400 rounded-md uppercase shadow-sm">
              Cancelled
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-slate-700 bg-slate-200 rounded-md uppercase shadow-sm">
              <%= item.status %>
            </span>
          <% } %>
          
          <span class="inline-flex items-center px-3 py-1 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-100 text-[10px] font-bold tracking-widest uppercase truncate max-w-[120px]">
            <%= item.category %>
          </span>
        </div>
        
        <h3 class="text-xl font-black text-slate-900 tracking-tight leading-tight group-hover:text-indigo-700 transition-colors line-clamp-2" title="<%= item.title %>">
          <a href="/events/<%= item.id %>" class="focus:outline-none before:absolute before:inset-0"><%= item.title %></a>
        </h3>
      </div>
    </div>

    <div class="space-y-3 text-sm text-slate-500 font-medium mt-auto pointer-events-none mb-2">
      <div class="flex items-start gap-2">
        <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mt-0.5 flex-shrink-0 group-hover:bg-indigo-50 group-hover:text-indigo-500 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        </div>
        <div class="flex flex-col">
          <% const start = new Date(item.startDate); const end = new Date(item.endDate); %>
          <time class="text-slate-900 font-bold"><%= start.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></time>
          <span class="text-xs text-slate-400 mt-0.5">to <%= end.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }) %></span>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 flex-shrink-0 group-hover:bg-indigo-50 group-hover:text-indigo-500 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
        <span class="text-slate-700 font-bold"><%= item.attendeeCount %> <span class="text-slate-400 font-medium">/ <%= item.capacity === 0 ? 'Unlimited' : item.capacity %> Attendees</span></span>
      </div>
    </div>
  </div>

  <div class="bg-slate-50 border-t border-slate-100 p-4 relative z-20 flex flex-col gap-2 mt-auto">
    <% if (item.status === "draft") { %>
      <button
          hx-post="/events/<%= item.id %>/publish"
          hx-target="#event-row-<%= item.id %>"
          hx-swap="outerHTML"
          class="w-full py-2.5 px-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl shadow-sm transition-colors focus:outline-none cursor-pointer">
          Publish Now
      </button>
    <% } %>
    
    <% if (item.status === "published") { %>
      <button
          hx-post="/events/<%= item.id %>/cancel"
          hx-target="#event-row-<%= item.id %>"
          hx-swap="outerHTML"
          class="w-full py-2.5 px-4 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold rounded-xl transition-colors focus:outline-none cursor-pointer">
          Cancel Event
      </button>
    <% } %>

    <a href="/events/<%= item.id %>" class="w-full text-center py-2.5 px-4 bg-white border border-slate-200 hover:border-indigo-300 hover:text-indigo-700 text-slate-700 font-bold rounded-xl shadow-sm transition-all block cursor-pointer text-sm">
      Manage Details
    </a>
  </div>
</article>