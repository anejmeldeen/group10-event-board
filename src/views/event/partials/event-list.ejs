<div class="space-y-6">
  <% if (!events || events.length === 0) { %>
    <div class="bg-white rounded-3xl border border-slate-100 p-16 text-center shadow-2xl shadow-slate-200/30">
      <div class="w-24 h-24 bg-indigo-50 text-indigo-300 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      </div>
      <h3 class="text-2xl font-black text-slate-900 tracking-tight">No events found</h3>
      <p class="text-slate-500 mt-2 text-lg">We couldn't find any events matching your criteria. Try adjusting your filters.</p>
      <button type="button" onclick="window.location.href='/home'" class="mt-8 px-6 py-3 bg-indigo-50 text-indigo-700 font-bold rounded-xl hover:bg-indigo-100 transition-colors cursor-pointer">Clear Filters</button>
    </div>
  <% } else { %>
    <% events.forEach(event => { %>
      <article 
        x-data="{
          startDate: '<%= event.startDate %>',
          relativeTime: '',
          init() {
            if (!this.startDate) return;
            const d = new Date(this.startDate);
            const now = new Date();
            const dDay = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            const nowDay = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const diffInDays = Math.round((dDay - nowDay) / (1000 * 60 * 60 * 24));
            
            if (diffInDays === 0) {
              this.relativeTime = 'today';
            } else if (diffInDays === 1) {
              this.relativeTime = 'tomorrow';
            } else if (diffInDays === -1) {
              this.relativeTime = 'yesterday';
            } else if (diffInDays > 1) {
              this.relativeTime = `in ${diffInDays} days`;
            } else if (diffInDays < -1) {
              this.relativeTime = `${Math.abs(diffInDays)} days ago`;
            }
          }
        }" 
        class="bg-white rounded-3xl shadow-lg shadow-slate-200/50 border border-slate-100 overflow-hidden transition-all duration-300 hover:shadow-2xl hover:-translate-y-1 group relative">
        <!-- Decorative side bar -->
        <div class="absolute left-0 top-0 bottom-0 w-2 bg-indigo-500 transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300"></div>

        <div class="flex flex-col md:flex-row min-h-[160px]">
          <!-- Left Content -->
          <div class="flex-grow p-5 md:p-6 flex flex-col">
            <div class="flex items-start justify-between gap-4 mb-2">
              <div class="w-full">
                <div class="flex gap-2 items-center mb-2">
                  <% if (event.status === 'draft') { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-amber-900 bg-amber-400 rounded-md uppercase shadow-sm">
                      Draft
                    </span>
                  <% } else if (event.status === 'cancelled') { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-rose-900 bg-rose-400 rounded-md uppercase shadow-sm">
                      Cancelled
                    </span>
                  <% } %>
                  
                  <span class="inline-flex items-center px-3 py-1 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-100 text-[10px] font-bold tracking-widest uppercase">
                    <%= event.category %>
                  </span>
                </div>
                
                <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight leading-tight group-hover:text-indigo-700 transition-colors">
                  <a href="/events/<%= event.id %>" class="focus:outline-none before:absolute before:inset-0"><%= event.title %></a>
                </h2>
                
                <div class="flex flex-wrap items-center text-slate-500 mt-2 text-sm font-medium gap-x-6 gap-y-2 relative z-10 pointer-events-none">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 group-hover:bg-indigo-50 group-hover:text-indigo-500 transition-colors">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <time class="text-slate-900 font-bold"><%= new Date(event.startDate).toLocaleString([], { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></time>
                      <span x-cloak x-show="relativeTime" style="display: none;" class="text-indigo-600 text-[10px] font-bold tracking-wider uppercase" x-text="relativeTime"></span>
                    </div>
                  </div>
                  
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 group-hover:bg-indigo-50 group-hover:text-indigo-500 transition-colors">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    </div>
                    <span class="text-slate-700 font-medium"><%= event.location %></span>
                  </div>
                </div>
              </div>
            </div>

            <p class="text-slate-600 truncate leading-relaxed mb-4 mt-1 max-w-3xl text-base"><%= event.description %></p>

            <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100/60">
              <div class="flex items-center gap-4">
                <div class="flex -space-x-2">
                  <div class="w-8 h-8 rounded-full bg-indigo-100 border-2 border-white flex items-center justify-center font-bold text-indigo-700 shadow-sm relative z-10 text-xs">
                    <%= event.attendeeCount %>
                  </div>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-bold text-slate-900 leading-tight">Attendees</span>
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider leading-tight">
                    <% if (event.capacity > 0) { %> <%= event.capacity %> max <% } else { %> Unlimited <% } %>
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-gradient-to-br from-slate-200 to-slate-300 flex items-center justify-center text-slate-600 font-bold text-xs shadow-inner">
                  <%= event.organizerName.charAt(0).toUpperCase() %>
                </div>
                <span class="text-sm text-slate-500 font-medium">
                  By <span class="text-slate-900 font-bold"><%= event.organizerName %></span>
                </span>
              </div>
            </div>
          </div>

          <!-- Right Action Bar -->
          <div class="bg-slate-50 md:border-l border-slate-100 p-5 md:p-6 flex flex-col justify-center min-w-[220px] relative z-20">
            <% if (user?.role === 'admin' || user?.role === 'staff') { %>
              <div class="space-y-3 w-full">
                <a href="/events/<%= event.id %>" class="w-full text-center py-2.5 px-4 bg-white border-2 border-indigo-100 hover:border-indigo-600 hover:text-indigo-700 text-indigo-600 font-bold rounded-xl shadow-sm transition-all block relative z-30 cursor-pointer">
                  Manage Event
                </a>
                <% if (event.status === 'draft') { %>
                  <form method="POST" action="/events/<%= event.id %>/publish" class="relative z-30">
                    <button type="submit" class="w-full py-2.5 px-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl shadow-lg shadow-emerald-500/30 transition-all cursor-pointer">
                      Publish Now
                    </button>
                  </form>
                <% } %>
              </div>
            <% } else { %>
              <div class="space-y-3 w-full flex flex-col justify-center h-full">
                <a href="/events/<%= event.id %>" class="w-full text-center py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black rounded-xl shadow-lg shadow-indigo-600/30 transition-all text-base no-underline transform hover:-translate-y-0.5 relative z-30 cursor-pointer">
                  View Details
                </a>

                <div class="relative z-30">
                  <%- include("../../partials/saved-toggle-button", {
                    eventId: event.id,
                    saved: typeof savedEventIds !== 'undefined' && savedEventIds.has ? savedEventIds.has(event.id) : false,
                    returnTo: "/home",
                    context: "home",
                    htmx: true,
                  }) %>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  <% } %>
</div>