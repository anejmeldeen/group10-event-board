<!-- Hero Header Section -->
<div class="relative bg-gradient-to-br from-indigo-900 via-indigo-800 to-blue-900 rounded-3xl overflow-hidden mb-10 shadow-2xl shadow-slate-200/50">
  <div class="absolute top-0 right-0 -mt-20 -mr-20 w-80 h-80 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
  <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-72 h-72 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse" style="animation-delay: 2s;"></div>
  
  <div class="relative z-10 px-8 py-10 sm:px-12 sm:py-12 text-white flex flex-col md:flex-row items-center justify-between gap-8">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-indigo-100 bg-white/10 rounded-full uppercase shadow-lg shadow-black/10 backdrop-blur-md border border-white/20 mb-3">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
        Edit Event
      </div>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-indigo-100">
        Update Event Details
      </h1>
      <p class="text-indigo-200 mt-2 text-lg font-medium">Refine your event information and save your changes.</p>
    </div>
    <div class="shrink-0 flex gap-4">
      <a href="/events/<%= event.id %>" class="px-6 py-3 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white font-bold rounded-xl transition-all shadow-lg no-underline flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Back to Event
      </a>
    </div>
  </div>
</div>

<div id="edit-error" aria-live="polite">
  <% if (pageError) { %>
    <%- include("../partials/error", { message: pageError }) %>
  <% } %>
</div>

<div class="max-w-4xl mx-auto">
  <form hx-post="/events/<%= event.id %>/edit" hx-target="#edit-error" hx-swap="innerHTML" class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
    <div class="p-8 sm:p-10 space-y-8">
      
      <!-- Basic Information -->
      <div class="space-y-6">
        <h2 class="text-xl font-black text-slate-900 flex items-center gap-3 border-b border-slate-100 pb-3">
          <span class="w-5 h-1 bg-indigo-600 rounded-full inline-block"></span>
          General Information
        </h2>

        <div class="grid grid-cols-1 gap-6">
          <div>
            <label for="title" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">Event Title <span class="text-rose-500">*</span></label>
            <input
              type="text"
              id="title"
              name="title"
              value="<%= input.title || '' %>"
              required
              maxlength="200"
              placeholder="Give your event a clear, catchy name"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
            />
          </div>

          <div>
            <label for="description" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">Description <span class="text-rose-500">*</span></label>
            <textarea
              id="description"
              name="description"
              rows="4"
              required
              placeholder="What is this event about? What should attendees know?"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
            ><%= input.description || '' %></textarea>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="location" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">Location <span class="text-rose-500">*</span></label>
              <input
                type="text"
                id="location"
                name="location"
                value="<%= input.location || '' %>"
                required
                placeholder="Where is it happening?"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
              />
            </div>

            <div>
              <label for="category" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">Category <span class="text-rose-500">*</span></label>
              <div class="relative">
                <select
                  id="category"
                  name="category"
                  required
                  class="w-full appearance-none px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm pr-10"
                >
                  <option value="" disabled>Select a category</option>
                  <option value="social" <%= input.category === "social" ? "selected" : "" %>>Social</option>
                  <option value="educational" <%= input.category === "educational" ? "selected" : "" %>>Educational</option>
                  <option value="volunteer" <%= input.category === "volunteer" ? "selected" : "" %>>Volunteer</option>
                  <option value="sports" <%= input.category === "sports" ? "selected" : "" %>>Sports</option>
                  <option value="arts" <%= input.category === "arts" ? "selected" : "" %>>Arts</option>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Schedule & Capacity -->
      <div class="space-y-6">
        <h2 class="text-xl font-black text-slate-900 flex items-center gap-3 border-b border-slate-100 pb-3">
          <span class="w-5 h-1 bg-indigo-600 rounded-full inline-block"></span>
          Schedule & Capacity
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="startDate" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">Start Date & Time <span class="text-rose-500">*</span></label>
            <input
              type="datetime-local"
              id="startDate"
              name="startDate"
              required
              value="<%= (input.startDate || '').slice(0, 16) %>"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
            />
          </div>

          <div>
            <label for="endDate" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">End Date & Time <span class="text-rose-500">*</span></label>
            <input
              type="datetime-local"
              id="endDate"
              name="endDate"
              required
              value="<%= (input.endDate || '').slice(0, 16) %>"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
            />
          </div>

          <div>
            <label for="capacity" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">Maximum Capacity</label>
            <input
              type="number"
              id="capacity"
              name="capacity"
              min="0"
              max="100000"
              value="<%= input.capacity || '0' %>"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
            />
            <p class="text-slate-500 text-[10px] font-bold uppercase tracking-wide mt-1.5 ml-1">
              Use 0 for unlimited attendees.
            </p>
          </div>
        </div>
      </div>

      <!-- Privacy Section -->
      <div class="space-y-6 pt-2">
        <h2 class="text-xl font-black text-slate-900 flex items-center gap-3 border-b border-slate-100 pb-3">
          <span class="w-5 h-1 bg-indigo-600 rounded-full inline-block"></span>
          Privacy & Invites
        </h2>

        <% 
          const isInitialPrivate = input.isPrivate === 'on' || input.isPrivate === 'true' || input.isPrivate === true;
        %>
        <div x-data="{ isPrivate: <%= isInitialPrivate ? 'true' : 'false' %> }">
          <label class="flex items-center gap-4 cursor-pointer group">
            <div class="relative">
              <input type="checkbox" id="isPrivate" name="isPrivate" x-model="isPrivate" value="on" class="sr-only">
              <div class="block w-14 h-8 rounded-full transition-colors duration-300" :class="isPrivate ? 'bg-emerald-500 shadow-lg shadow-emerald-500/30' : 'bg-indigo-100 border border-indigo-200'"></div>
              <div class="absolute left-1 top-1 bg-white w-6 h-6 rounded-full transition-transform duration-300 shadow-md" :class="isPrivate ? 'transform translate-x-6' : ''"></div>
            </div>
            <div>
              <div class="text-sm font-black text-slate-900 group-hover:text-indigo-600 transition-colors">Private Event</div>
              <div class="text-xs font-medium text-slate-500">Only invited users can RSVP</div>
            </div>
          </label>

          <div x-show="isPrivate" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 -translate-y-4" x-transition:enter-end="opacity-100 translate-y-0" class="mt-6 p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
            <label for="invitedEmails" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1 ml-1">Invited Emails</label>
            <textarea
              id="invitedEmails"
              name="invitedEmails"
              rows="3"
              placeholder="john@example.com, sara@example.com&#10;One email per line or comma separated"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
            ><%= input.invitedEmails || '' %></textarea>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Separate emails with commas or new lines.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sticky Footer -->
    <div class="bg-slate-50 border-t border-slate-100 p-8 flex items-center justify-between gap-4">
      <p class="text-sm font-medium text-slate-500 hidden sm:block">
        Required fields are marked with an asterisk (<span class="text-rose-500">*</span>)
      </p>
      <div class="flex items-center gap-4 w-full sm:w-auto">
        <a href="/events/<%= event.id %>" class="flex-1 sm:flex-none px-6 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-bold hover:bg-slate-50 hover:border-slate-300 transition-all text-center no-underline">
          Cancel
        </a>
        <button
          type="submit"
          class="flex-1 sm:flex-none px-10 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-black shadow-lg shadow-indigo-500/30 transition-all hover:-translate-y-0.5 active:scale-95 cursor-pointer border-none"
        >
          Save Changes
        </button>
      </div>
    </div>

  </form>
</div>
