<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-2">Edit Event</h1>
  <p class="text-slate-500">
    Update the details below and click save. Changes take effect immediately.
  </p>
</section>

<div id="edit-error" aria-live="polite">
  <% if (pageError) { %>
    <%- include("../partials/error", { message: pageError }) %>
  <% } %>
</div>

<section class="max-w-3xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  
  <form 
    hx-post="/events/<%= event.id %>/edit" 
    hx-target="#edit-error" 
    hx-swap="innerHTML"
    
    x-data="editFormHandler()"
    x-init="init()"
    x-on:input="markDirty()"
    x-on:submit="handleSubmit($event)"
    x-on:beforeunload.window="warnIfDirty($event)"

    class="space-y-4"
  >

    <div>
      <label for="title" class="block text-sm font-medium text-slate-700 mb-1">Title</label>
      <input type="text" id="title" name="title" value="<%= input.title || '' %>" required maxlength="200"
        class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
    </div>

    <div>
      <label for="description" class="block text-sm font-medium text-slate-700 mb-1">Description</label>
      <textarea id="description" name="description" rows="4" required
        class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"><%= input.description || '' %></textarea>
    </div>

    <div>
      <label for="location" class="block text-sm font-medium text-slate-700 mb-1">Location</label>
      <input type="text" id="location" name="location" value="<%= input.location || '' %>" required
        class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
    </div>

    <div>
      <label for="category" class="block text-sm font-medium text-slate-700 mb-1">Category</label>
      <input type="text" id="category" name="category" value="<%= input.category || '' %>" required
        class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="startDate" class="block text-sm font-medium text-slate-700 mb-1">Start date</label>
        <input type="datetime-local" id="startDate" name="startDate"
          value="<%= (input.startDate || '').slice(0, 16) %>" required
          class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
      <div>
        <label for="endDate" class="block text-sm font-medium text-slate-700 mb-1">End date</label>
        <input type="datetime-local" id="endDate" name="endDate"
          value="<%= (input.endDate || '').slice(0, 16) %>" required
          class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
    </div>

    <div>
      <label for="capacity" class="block text-sm font-medium text-slate-700 mb-1">Capacity</label>
      <input type="number" id="capacity" name="capacity" value="<%= input.capacity || '0' %>" min="0"
        class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
      <p class="text-xs text-slate-500 mt-1">Use 0 for unlimited.</p>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button 
        type="submit"
        :disabled="!dirty"
        :class="dirty ? 'bg-blue-600 hover:bg-blue-700' : 'bg-blue-400 cursor-not-allowed'"
        class="px-4 py-2 rounded-lg text-white font-medium transition"
      >
        Save changes
      </button>

      <a 
        href="/events/<%= event.id %>" 
        @click.prevent="confirmLeave($event)"
        class="px-4 py-2 rounded-lg bg-white text-slate-700 border border-slate-300 hover:bg-slate-50 no-underline"
      >
        Cancel
      </a>

      <!-- Unsaved indicator -->
      <span 
        x-show="dirty" 
        x-transition
        class="text-sm text-amber-600"
      >
        Unsaved changes
      </span>
    </div>

  </form>
</section>

<script>
function editFormHandler() {
  return {
    dirty: false,
    initialData: '',

    init() {
      this.initialData = this.serialize()
    },

    serialize() {
      const form = this.$el
      return new URLSearchParams(new FormData(form)).toString()
    },

    markDirty() {
      this.dirty = this.serialize() !== this.initialData
    },

    handleSubmit(event) {
      if (!this.dirty) {
        event.preventDefault()
        return
      }
      this.dirty = false
    },

    warnIfDirty(event) {
      if (this.dirty) {
        event.preventDefault()
        event.returnValue = ''
      }
    },

    confirmLeave(event) {
      if (this.dirty && !confirm('You have unsaved changes. Leave anyway?')) {
        event.preventDefault()
      }
    }
  }
}
</script>