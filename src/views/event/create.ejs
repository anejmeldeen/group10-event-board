<section class="max-w-3xl mx-auto p-4 sm:p-6 lg:p-8">
  <div class="bg-white rounded-3xl shadow-2xl shadow-slate-200/50 border border-slate-100 overflow-hidden relative">
    
    <!-- Header Hero Section -->
    <div class="relative bg-gradient-to-br from-indigo-900 via-indigo-800 to-blue-900 px-6 py-6 sm:px-8 sm:py-8 text-white overflow-hidden">
      <!-- Decorative background elements -->
      <div class="absolute top-0 right-0 -mt-20 -mr-20 w-80 h-80 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
      <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-72 h-72 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse" style="animation-delay: 2s;"></div>
      
      <div class="relative z-10 flex flex-col items-start gap-2 sm:gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold tracking-widest text-indigo-100 bg-white/10 rounded-full uppercase shadow-lg shadow-black/10 backdrop-blur-md border border-white/20">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          Organizer Tool
        </span>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight leading-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-indigo-100">
          Create New Event
        </h1>
        <p class="text-indigo-200 text-xs sm:text-sm font-medium max-w-xl">
          Events are initially saved as drafts and are not visible to members until you publish them.
        </p>
      </div>
    </div>

    <!-- Content Section -->
    <div class="p-6 sm:p-8">
      <!-- Error container — HTMX swaps error partials in here -->
      <div id="form-errors">
        <% if (pageError) { %>
          <%- include("../partials/error", { message: pageError }) %>
        <% } %>
      </div>

      <form
        id="create-event-form"
        method="post"
        action="/events/create"
        hx-post="/events/create"
        hx-target="#form-errors"
        hx-swap="innerHTML"
        class="space-y-6"
      >
        <div class="space-y-4">
          <h2 class="text-lg font-black text-slate-900 flex items-center gap-3 border-b border-slate-100 pb-2">
            <span class="w-5 h-1 bg-indigo-600 rounded-full inline-block"></span>
            Basic Information
          </h2>

          <div>
            <label for="title" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1 ml-1">Event Title <span class="text-rose-500">*</span></label>
            <input
              type="text"
              id="title"
              name="title"
              required
              minlength="3"
              maxlength="200"
              value="<%= input.title || '' %>"
              placeholder="e.g. CS326 Programming Contest"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
            />
          </div>

          <div x-data="{ description: '', maxLength: 5000 }" x-init="description = $refs.desc.value">
            <div class="flex justify-between items-end mb-1 ml-1">
              <label for="description" class="block text-xs font-black text-slate-400 uppercase tracking-widest">Description <span class="text-rose-500">*</span></label>
              <span class="text-xs font-bold" :class="description.length > maxLength ? 'text-rose-500' : 'text-slate-400'">
                <span x-text="description.length"></span> / <span x-text="maxLength"></span>
              </span>
            </div>
            <textarea
              id="description"
              name="description"
              required
              minlength="10"
              maxlength="5000"
              rows="3"
              x-ref="desc"
              x-model="description"
              placeholder="Tell people what this event is about..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm resize-y"
            ><%= input.description || '' %></textarea>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="location" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1 ml-1">Location <span class="text-rose-500">*</span></label>
              <input
                type="text"
                id="location"
                name="location"
                required
                maxlength="300"
                value="<%= input.location || '' %>"
                placeholder="Building name, room number, etc."
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
              />
            </div>
            <div>
              <label for="category" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1 ml-1">Category <span class="text-rose-500">*</span></label>
              <input
                type="text"
                id="category"
                name="category"
                value="<%= input.category || '' %>"
                placeholder="e.g. Workshop, Social, Seminar, etc."
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
              />
            </div>
          </div>
        </div>

        <div class="space-y-4 pt-2">
          <h2 class="text-lg font-black text-slate-900 flex items-center gap-3 border-b border-slate-100 pb-2">
            <span class="w-5 h-1 bg-indigo-600 rounded-full inline-block"></span>
            Schedule & Capacity
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="startDate" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1 ml-1">Start Date & Time <span class="text-rose-500">*</span></label>
              <input
                type="datetime-local"
                id="startDate"
                name="startDate"
                required
                value="<%= input.startDate || '' %>"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
              />
            </div>

            <div>
              <label for="endDate" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1 ml-1">End Date & Time <span class="text-rose-500">*</span></label>
              <input
                type="datetime-local"
                id="endDate"
                name="endDate"
                required
                value="<%= input.endDate || '' %>"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
              />
            </div>
          </div>

          <div>
            <label for="capacity" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1 ml-1">Maximum Capacity</label>
            <input
              type="number"
              id="capacity"
              name="capacity"
              min="0"
              max="100000"
              value="<%= input.capacity || '' %>"
              placeholder="Leave empty or 0 for unlimited"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-medium text-slate-700 shadow-sm"
            />
            <p class="text-slate-500 text-xs font-medium mt-1 ml-1 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              If set to 0, the event will have unlimited capacity.
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex flex-col-reverse sm:flex-row justify-end gap-3 mt-4">
          <a
            href="/home"
            class="px-5 py-2.5 rounded-xl border-2 border-slate-200 text-slate-700 font-bold hover:bg-slate-50 transition-colors text-center no-underline text-sm"
          >
            Cancel
          </a>
          <button
            type="submit"
            id="create-event-submit"
            class="px-6 py-2.5 rounded-xl bg-indigo-600 text-white font-black hover:bg-indigo-700 shadow-lg shadow-indigo-600/30 transition-all text-center cursor-pointer text-sm"
          >
            Save as Draft
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
