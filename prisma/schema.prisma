generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id            String   @id
  title         String
  description   String
  location      String
  category      String
  startDate     String
  endDate       String
  organizerId   String
  organizerName String
  status        String   @default("draft")
  capacity      Int      @default(0)
  attendeeCount Int      @default(0)
  createdAt     String
  updatedAt     String

  rsvps         Rsvp[]
}

model Rsvp {
  id        String @id
  eventId   String
  userId    String
  status    String @default("going")
  createdAt String

  event     Event  @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
}